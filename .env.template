# =============================================================================
# vaultwarden-masterless Configuration
# =============================================================================
# Copy this file to .env and adjust values for your deployment.

# --- Server ---
# Address and port vaultwarden-masterless listens on
HOST=127.0.0.1
PORT=8484

# --- Vaultwarden Integration ---
# The base URL of your Vaultwarden instance (used to validate JWTs)
VAULTWARDEN_URL=https://vaultwarden.example.com

# Path to Vaultwarden's RSA public key (PEM) for JWT verification.
# You can export it from Vaultwarden's data dir: data/rsa_key.pub.pem
VAULTWARDEN_RSA_PUBLIC_KEY_FILE=./data/vw_rsa_key.pub.pem

# --- Database ---
# Path to the SQLite database file
DATABASE_PATH=./data/masterless.sqlite

# --- RSA Key (protects the symmetric key that encrypts user keys at rest) ---
# Path to the RSA private key PEM file used to wrap/unwrap the AES wrapping key
RSA_PRIVATE_KEY_FILE=./data/rsa_private.pem
# Path to the RSA public key PEM file
RSA_PUBLIC_KEY_FILE=./data/rsa_public.pem

# --- Reverse Proxy Mode ---
# When enabled, vaultwarden-masterless acts as the client-facing entry point,
# proxying all requests to Vaultwarden and injecting passwordless flags
# into API responses. No Vaultwarden source modifications needed.
PROXY_ENABLED=true

# The public URL of the /user-keys endpoint, as seen by clients (browsers/apps).
# This is injected into Vaultwarden API responses as "KeyConnectorUrl" so
# clients know where to POST (first login) or GET (subsequent logins) their
# vault encryption key. Must be an absolute URL reachable from the browser.
# If empty, passwordless flags are NOT injected (proxy still works, but
# clients will use master-password auth as normal).
# Examples:
#   https://vault.example.com/user-keys   (when masterless is the public entry point)
#   http://localhost:8484/user-keys        (local development)
USER_KEYS_URL=http://localhost:8484/user-keys

# --- Key Rotation ---
# Automatically rotate the AES wrapping secret every N hours.
# All user keys are re-encrypted atomically — if anything fails, nothing changes.
# Set to 0 to disable automatic rotation.
# Recommended: 720 (30 days) or 168 (weekly)
ROTATION_INTERVAL_HOURS=0

# --- Domain (JWT issuer validation) ---
# When running behind a reverse proxy, set this to the public URL clients use.
# Vaultwarden tokens use the DOMAIN as the JWT issuer. If the proxy's
# VAULTWARDEN_URL is an internal address (e.g. http://vaultwarden:80), the
# issuer won't match — set DOMAIN to the public URL so tokens validate.
# Example: https://vault.example.com
# DOMAIN=

# --- Synthetic Organization ---
# When the user has no organizations, the proxy injects a synthetic one so
# the Bitwarden client's Key Connector flow works. These control its display
# name and identifier.
SYNTHETIC_ORG_NAME=Vaultwarden Masterless
SYNTHETIC_ORG_IDENTIFIER=vaultwarden-masterless

# --- Logging ---
# Levels: trace, debug, info, warn, error
LOG_LEVEL=info

# --- Compatibility reporting (GET /version) ---
# The proxy reports BOTH what it was tested against and what it can see running.
# COMPAT_VW_VERSION is the Vaultwarden version covered by CI (see COMPATIBILITY.md).
# At runtime the proxy asks Vaultwarden for its version and reports a `status`
# verdict: match | newer | older | unreachable. Anything other than `match`
# means this Vaultwarden was never tested against this build.
COMPAT_VW_VERSION=1.37.3
COMPAT_KC_VERSION=26.3.4
COMPAT_CLIENTS={"web":"2024.x - 2026.x","desktop":"2024.x - 2026.x","browser_extension":"2024.x - 2026.x","mobile":"untested"}
COMPAT_LAST_TESTED=2026-09-18
COMPAT_STATUS_URL=https://github.com/antoniolago/vaultwarden-masterless/blob/main/COMPATIBILITY.md

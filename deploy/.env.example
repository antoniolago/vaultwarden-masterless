# Docker Compose environment variables
# Copy to .env and adjust as needed:  cp .env.example .env

# Vaultwarden admin token
VW_ADMIN_TOKEN=admin123

# OIDC client credentials (set after creating the client in Pocket-ID)
OIDC_CLIENT_ID=vaultwarden
OIDC_CLIENT_SECRET=vaultwarden-secret

# Pocket-ID encryption key (auto-generated by setup.sh if empty)
POCKET_ID_ENCRYPTION_KEY=

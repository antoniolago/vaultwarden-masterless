#################################
### E2E Test Configuration     ###
#################################
# TEST_HOST: address tests use to reach Docker host services.
# Override in CI (e.g. Docker-in-Docker) with the gateway IP.
TEST_HOST=127.0.0.1
ENV=e2e
DC_ENV_FILE=test.env
COMPOSE_IGNORE_ORPHANS=True
DOCKER_BUILDKIT=1

################
# Users Config #
################
TEST_USER=test
TEST_USER_PASSWORD=${TEST_USER}
TEST_USER_MAIL=${TEST_USER}@yopmail.com

###################
# Keycloak Config #
###################
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN}
# Address clients (the setup script's kcadm.sh, this test env) dial.
# It must be a real address: `kcadm.sh` against 0.0.0.0 fails with
# "Failed to send request ... System error" and the setup job then loops forever
# waiting for the realm it can never create. The Keycloak *service* pins its own
# bind address to 0.0.0.0 in docker-compose.e2e.yml, so this only affects clients.
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT=18080

# Script parameters
TEST_REALM=test
DUMMY_REALM=dummy
DUMMY_AUTHORITY=http://${TEST_HOST}:${KC_HTTP_PORT}/realms/${DUMMY_REALM}

######################
# Vaultwarden Config #
######################
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=18000
# DOMAIN points to masterless proxy — clients connect here (now using HTTPS)
DOMAIN=https://${TEST_HOST}:18443
ADMIN_TOKEN=e2e-admin-token
LOG_LEVEL=info,vaultwarden::sso=debug,oidcwarden::sso=debug
I_REALLY_WANT_VOLATILE_STORAGE=true

# SSO / OIDC — pointing to Keycloak
SSO_ENABLED=true
SSO_ONLY=false
SSO_CLIENT_ID=warden
SSO_CLIENT_SECRET=warden
SSO_AUTHORITY=http://${TEST_HOST}:${KC_HTTP_PORT}/realms/${TEST_REALM}

######################
# Masterless Config  #
######################
MASTERLESS_PORT=18443
